# Copy to .env and fill in. Only the token and the repository are required.

# --- access (one of the two) ---
# The token the apps send as "Authorization: Bearer <token>". Make one with:  openssl rand -base64 32
MCC_TOKEN=
# ...or only its SHA-256 hex digest, so the server never stores the plain token:
#   printf %s "<token>" | sha256sum
MCC_TOKEN_SHA256=

# --- recipe repository ---
# Your private recipe repository (made from mcc-app's recipe-repo/), cloned into MCC_REPO_DIR on first start.
MCC_REPO_URL=git@github.com:<you>/<your-recipes>.git
MCC_GIT_BRANCH=main
# Who the server's commits are by.
MCC_GIT_NAME=mcc-upload
MCC_GIT_EMAIL=mcc-upload@localhost
# Run after each push, from the repository folder, e.g. to rebuild the recipe server. Empty = nothing (for
# web servers that serve the clone directly). See "Deploying" in README.md.
MCC_DEPLOY_CMD=

# --- transcripts ---
# Wyoming speech-to-text server for videos without subtitles (Home Assistant's Whisper add-on: <ha-ip>, 10300).
# Empty = skip that step and return the description only.
MCC_WHISPER_HOST=
MCC_WHISPER_PORT=10300
# Language for speech-to-text, e.g. pt or en. Empty = the video's language when known, else the server decides.
MCC_WHISPER_LANGUAGE=
MCC_MAX_AUDIO_MINUTES=30
MCC_TRANSCRIPT_TIMEOUT=600
MCC_CACHE_HOURS=24
# 1 = install the newest yt-dlp into the data folder at every start (when YouTube changes faster than you rebuild).
MCC_YTDLP_UPDATE=0

# --- server ---
MCC_PORT=8080
MCC_MAX_BODY=1048576
# The user the container runs as (docker-compose.yml). Match the owner of ./data.
MCC_UID=1000
MCC_GID=1000
